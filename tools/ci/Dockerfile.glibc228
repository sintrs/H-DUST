# 目标：在 glibc 2.28 的编译环境里产出 Horizon 启动器 / 客户端，
# 让二进制在 Debian 10、RHEL·CentOS 8、麒麟 V10、UOS 20 这些机器上也能跑。
#
# 为什么是 Debian 10：
#   - buster 的 glibc 正好 2.28（RHEL/CentOS 8 也是 2.28），是这套工具链能取到的最老一档；
#   - 再往下（Debian 9 = 2.24）没有意义：GitHub Actions 的 Node 20 自己就要求 glibc >= 2.28，
#     容器 job 一跑 checkout 就崩。
# 产物对新系统没有副作用：glibc 向下兼容是单向的，2.28 编出来的东西在 2.35/2.39 上照常跑。
FROM debian:10

# buster 已 EOL，官方镜像里那套 sources.list 全部失效，只能改指 archive。
# Check-Valid-Until 必须关掉：归档源的 Release 文件早就过期了。
RUN set -eux; \
    sed -i -e 's|deb.debian.org|archive.debian.org|g' \
           -e 's|security.debian.org|archive.debian.org|g' \
           -e '/buster-updates/d' /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until "false";\nAcquire::Retries "3";\nAcquire::http::Timeout "60";\n' \
        > /etc/apt/apt.conf.d/99eol-archive; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential pkg-config curl ca-certificates git \
        libxkbcommon-x11-dev libwayland-dev libx11-xcb-dev \
        libfontconfig-dev libvulkan-dev libasound2-dev libudev-dev \
        python3; \
    rm -rf /var/lib/apt/lists/*
# python3 是给上游 tools/check_cpu_baseline.py 用的（它按符号边界判断指令集，比数助记符准）。

# 不要用 buster 自带的 rustc（1.41），编不动 edition 2021 和 gpui-fast。
# rustup 的 stable 自身只要 glibc >= 2.17，在 buster 上可以正常跑。
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# rust-src + wasm32-unknown-unknown：上游客户端要顺带编一个共享的 wasm 标准库
#   cargo run -p cargo-horizon-mod -- wasm-std horizon-wasm-std.wasm
# llvm-tools：给 tools/check_cpu_baseline.py 提供 llvm-objdump。
# 真正的版本由 container-entry.sh 按源码里的 tools/ci/rust-version 再装一遍（上游钉了具体版本）。
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
          -c rust-src -c llvm-tools-preview -t wasm32-unknown-unknown; \
    rustc -Vv; \
    cargo -V

# 编译期把 cargo 的 registry 和 target 放在挂载卷上，重复编译不用从零来。
# 具体路径由 build-glibc228.sh 通过 -v / -e CARGO_TARGET_DIR 指定，这里只给默认值。
ENV CARGO_TARGET_DIR=/target

WORKDIR /src
CMD ["bash"]
